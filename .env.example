AUTH_SECRET=change-me-to-a-long-random-string
COOKIE_SECURE=false
# เมื่ออยู่หลัง portal ที่ path /Investment/ (ว่างหรือ / = root)
VITE_BASE=/Investment/
# Postgres ของ Investment (docker compose เปิดที่ host:5434)
# DATABASE_URL ใช้ใน backend/.env สำหรับ migrate จากเครื่อง host
# SEC Open Data — NAV กองทุนไทย (ใส่ใน backend/.env ด้วยเมื่อรัน api แยก)
SEC_API_KEY=
