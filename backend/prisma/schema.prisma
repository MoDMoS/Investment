generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  passwordHash String
  createdAt    DateTime     @default(now())
  transfers    FxTransfer[]
  trades       Trade[]
  dividends    Dividend[]
}

model FxTransfer {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime
  direction String
  thbAmount Float
  usdAmount Float
  rate      Float
  feeThb    Float    @default(0)
  feeUsd    Float    @default(0)
  note      String   @default("")
  createdAt DateTime @default(now())

  @@index([userId, date])
}

model Trade {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime
  ticker    String
  side      String
  shares    Float
  priceUsd  Float
  feeUsd    Float    @default(0)
  note      String   @default("")
  createdAt DateTime @default(now())

  @@index([userId, date])
}

model Dividend {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime
  ticker    String
  shares    Float    @default(0)
  grossUsd  Float
  taxUsd    Float    @default(0)
  netUsd    Float
  note      String   @default("")
  createdAt DateTime @default(now())

  @@index([userId, date])
}
