generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                   String              @id
  email                String              @unique
  name                 String
  passwordHash         String              @default("")
  repatriationGoalThb  Float?
  createdAt            DateTime            @default(now())
  accounts             Account[]
  transfers            FxTransfer[]
  trades               Trade[]
  dividends            Dividend[]
  cashEntries          CashEntry[]
  portfolioSnapshots   PortfolioSnapshot[]
}

model PortfolioSnapshot {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date            DateTime
  cashUsd         Float
  cashThb         Float
  marketValueUsd  Float?
  marketValueThb  Float?
  holdingsCostUsd Float
  holdingsCostThb Float
  thbNetAbroad    Float
  totalUsdApprox  Float?
  createdAt       DateTime @default(now())

  @@unique([userId, date])
  @@index([userId, date])
}

model Account {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  kind        String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  transfers   FxTransfer[]
  trades      Trade[]
  dividends   Dividend[]
  cashEntries CashEntry[]

  @@index([userId])
}

model FxTransfer {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  date      DateTime
  direction String
  thbAmount Float
  usdAmount Float
  rate      Float
  feeThb    Float    @default(0)
  feeUsd    Float    @default(0)
  note      String   @default("")
  createdAt DateTime @default(now())

  @@index([userId, date])
  @@index([accountId])
}

model Trade {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  date      DateTime
  ticker    String
  market    String   @default("foreign")
  side      String
  shares    Float
  priceUsd  Float
  feeUsd    Float    @default(0)
  note      String   @default("")
  createdAt DateTime @default(now())

  @@index([userId, date])
  @@index([accountId])
}

model Dividend {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  date      DateTime
  ticker    String
  market    String   @default("foreign")
  shares    Float    @default(0)
  grossUsd  Float
  taxUsd    Float    @default(0)
  netUsd    Float
  note      String   @default("")
  createdAt DateTime @default(now())

  @@index([userId, date])
  @@index([accountId])
}

model CashEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  date      DateTime
  direction String
  amount    Float
  note      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date])
  @@index([accountId])
}
